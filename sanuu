#!/bin/bash

# Sanuu Command Tool
# A utility script for Arch Linux users.

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ACPI Platform Profile Path
ACPI_PROFILE="/sys/firmware/acpi/platform_profile"
ACPI_CHOICES="/sys/firmware/acpi/platform_profile_choices"

# GitHub Repo Info
REPO_USER="Sanuu7"
REPO_NAME="archzshutils"
SCRIPT_FILE="sanuu"
INSTALLED_HASH="Unknown" # This will be replaced by install.sh

# Helper function for logging
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Animation function
run_with_animation() {
    local message="$1"
    shift
    local command="$@"
    
    local start_kb=$(get_free_space_kb)
    echo -ne "${BLUE}[WAIT]${NC} $message"
    
    local log_file="/tmp/sanuu_last_error.log"
    
    # Run command in background
    eval "$command" > /dev/null 2> "$log_file" &
    local pid=$!
    
    local delay=0.1
    local spinstr='|/-\'
    
    # Hide cursor
    tput civis
    
    while kill -0 $pid 2>/dev/null; do
        local temp=${spinstr#?}
        printf " ${BLUE}[%c]${NC}" "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b"
    done
    
    wait $pid
    local exit_code=$?
    
    # Show cursor
    tput cnorm
    
    local end_kb=$(get_free_space_kb)
    local diff_kb=$(( end_kb - start_kb ))
    if [[ $diff_kb -lt 0 ]]; then diff_kb=0; fi
    local diff_mb=$(awk "BEGIN {printf \"%.2f\", $diff_kb / 1024}")
    
    # Clear the spinner area and print final status
    if [ $exit_code -eq 0 ]; then
        echo -e " ${GREEN}[DONE]${NC} (${YELLOW}${diff_mb} MB${NC})"
    else
        echo -e " ${RED}[FAIL]${NC}"
        if [[ -f "$log_file" ]]; then
            log_error "Reason: $(tail -n 1 "$log_file")"
        fi
    fi
    rm -f "$log_file"
    return $exit_code
}

# Helper to request sudo if not root
ensure_sudo() {
    if [[ $EUID -ne 0 ]]; then
        sudo -v
        if [[ $? -ne 0 ]]; then
            log_error "Sudo privileges are required for this operation."
            exit 1
        fi
    fi
}

# Auto-update Check
check_for_updates() {
    # Skip if offline or API unreachable
    if ! ping -c 1 github.com &> /dev/null; then
        return
    fi
    
    echo -ne "${BLUE}[INFO]${NC} Checking for updates..."
    
    # Fetch latest commit from GitHub API
    local api_url="https://api.github.com/repos/$REPO_USER/$REPO_NAME/commits?path=$SCRIPT_FILE&per_page=1"
    local response=$(curl -s -m 5 "$api_url")
    
    if [[ -z "$response" ]]; then
        echo -e "\r${YELLOW}[WARN] Failed to check for updates.${NC}          "
        return
    fi
    
    # Extract latest hash and message (simple parsing to avoid jq dependency)
    local latest_hash=$(echo "$response" | grep '"sha":' | head -n 1 | cut -d '"' -f 4)
    local message=$(echo "$response" | grep '"message":' | head -n 1 | cut -d '"' -f 4)
    
    echo -e "\r                                             \r" # Clear line
    
    if [[ -n "$latest_hash" && "$latest_hash" != "$INSTALLED_HASH" && "$INSTALLED_HASH" != "Unknown" ]]; then
        echo -e "${GREEN}Update Available!${NC}"
        echo -e "Summary: ${YELLOW}New version found on GitHub${NC}"
        echo -e "Changelog: ${BLUE}$message${NC}"
        echo ""
        read -p "Do you want to update now? (y/n): " choice
        if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
            log_info "Updating..."
            ensure_sudo
            
            local download_url="https://raw.githubusercontent.com/$REPO_USER/$REPO_NAME/main/$SCRIPT_FILE"
            local temp_file="/tmp/$SCRIPT_FILE.new"
            
            if curl -s -L "$download_url" -o "$temp_file"; then
                # Inject new hash into the downloaded script before installing
                sed -i "s/INSTALLED_HASH=\"Unknown\"/INSTALLED_HASH=\"$latest_hash\"/" "$temp_file"
                
                chmod +x "$temp_file"
                sudo mv "$temp_file" "$(command -v sanuu)"
                log_success "Update successful! Please run your command again."
                exit 0
            else
                log_error "Failed to download update."
            fi
        fi
    fi
}

# Helper to get available profiles
get_available_profiles() {
    if [[ -f "$ACPI_CHOICES" ]]; then
        cat "$ACPI_CHOICES"
    else
        echo ""
    fi
}

# Helper to set ACPI profile
set_profile() {
    local target_profile="$1"
    
    # Check if profile exists
    local available_profiles=$(get_available_profiles)
    if [[ " $available_profiles " =~ " $target_profile " ]]; then
        log_info "Selected: $target_profile mode"
        ensure_sudo
        log_info "Applying settings..."
        
        # Set ACPI Profile
        echo "$target_profile" | sudo tee "$ACPI_PROFILE" > /dev/null
        log_success "ACPI profile set to $target_profile."
        
        # CPU Governor Logic (Best Effort mapping)
        if command -v cpupower &> /dev/null; then
            local governor="powersave"
            case "$target_profile" in
                performance)
                    governor="performance"
                    ;;
                balanced|balance)
                    if grep -q "schedutil" /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors; then
                        governor="schedutil"
                    else
                        governor="powersave"
                    fi
                    ;;
                low-power|quiet|silent)
                    governor="powersave"
                    ;;
            esac
            sudo cpupower frequency-set -g "$governor" > /dev/null
            log_success "CPU governor set to $governor."
        fi
        
    else
        log_error "Profile '$target_profile' is not available on this system."
        log_info "Available profiles: $available_profiles"
        exit 1
    fi
}

# Helper to get total available space in KB
# Sums available space of / and /home (deduplicating if they are the same)
get_free_space_kb() {
    # Check partitions for root and home user's cache
    local home_dir
    if [[ -n "$SUDO_USER" ]]; then
        home_dir="/home/$SUDO_USER"
    else
        home_dir="$HOME"
    fi
    
    df -k / "$home_dir" 2>/dev/null | tail -n +2 | awk '{print $1, $4}' | sort -u -k1,1 | awk '{sum+=$2} END {print sum}'
}

# clean logic extracted for reuse
perform_cleanup() {
    local deep=$1
    
    # Measure start space
    local start_space=$(get_free_space_kb)

    # Ensure no pacman lock
    if [[ -f /var/lib/pacman/db.lck ]]; then
        log_warn "Pacman database is locked. Waiting..."
        while [[ -f /var/lib/pacman/db.lck ]]; do
            sleep 1
        done
        log_success "Lock released."
    fi
    
    # 1. Clean pacman cache
    run_with_animation "Cleaning pacman cache (keep latest 2)..." "sudo paccache -rk2"
    run_with_animation "Cleaning uninstalled packages cache..." "sudo paccache -ruk0"

    # 2. Clean AUR helper cache (yay/paru)
    if [[ $EUID -eq 0 && -n "$SUDO_USER" ]]; then
         if command -v yay &> /dev/null; then
             run_with_animation "Cleaning yay cache..." "sudo -u $SUDO_USER yay -Sc --noconfirm"
         elif command -v paru &> /dev/null; then
             run_with_animation "Cleaning paru cache..." "sudo -u $SUDO_USER paru -Sc --noconfirm"
         fi
    else
         if command -v yay &> /dev/null; then
             run_with_animation "Cleaning yay cache..." "yay -Sc --noconfirm"
         elif command -v paru &> /dev/null; then
             run_with_animation "Cleaning paru cache..." "paru -Sc --noconfirm"
         fi
    fi

    # 3. Remove orphaned packages
    local orphans=$(pacman -Qtdq)
    if [[ -n "$orphans" ]]; then
        # Check for pacman lock
        if [[ -f /var/lib/pacman/db.lck ]]; then
            run_with_animation "Waiting for pacman database lock..." "while [ -f /var/lib/pacman/db.lck ]; do sleep 1; done"
        fi
        run_with_animation "Removing orphaned packages..." "sudo pacman -Rns $orphans --noconfirm"
    else
        run_with_animation "Checking for orphaned packages..." "sleep 0.5"
    fi

    # 4. Vacuum journal logs
    run_with_animation "Vacuuming system journal..." "sudo journalctl --vacuum-time=2weeks"

    # 5. Deep Clean specific
    if [[ "$deep" == "true" ]]; then
        log_info "Starting Deep Clean operations..."
        
        # User cache (thumbnails)
        if [[ -n "$SUDO_USER" ]]; then
             run_with_animation "Clearing user thumbnails..." "sudo -u $SUDO_USER rm -rf /home/$SUDO_USER/.cache/thumbnails/*"
        else
             run_with_animation "Clearing user thumbnails..." "rm -rf $HOME/.cache/thumbnails/*"
        fi
        
        # Temp files
        run_with_animation "Clearing /tmp directory (safe removal)..." "sudo find /tmp -type f -atime +1 -delete"
        run_with_animation "Clearing /var/tmp directory (safe removal)..." "sudo find /var/tmp -type f -atime +1 -delete"
        
        # Trash
        if [[ -n "$SUDO_USER" ]]; then
             run_with_animation "Emptying user trash..." "sudo -u $SUDO_USER rm -rf /home/$SUDO_USER/.local/share/Trash/*"
        else
             run_with_animation "Emptying trash..." "rm -rf $HOME/.local/share/Trash/*"
        fi
    fi
    
    # Measure end space
    local end_space=$(get_free_space_kb)
    
    # Calculate difference
    local diff_kb=$(( end_space - start_space ))
    
    # Handle case where diff is negative (downloads etc during run) or zero
    if [[ $diff_kb -lt 0 ]]; then diff_kb=0; fi
    
    local diff_mb=$(awk "BEGIN {printf \"%.2f\", $diff_kb / 1024}")
    
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}   CLEANUP COMPLETE${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo -e "Reclaimed Space: ${YELLOW}${diff_mb} MB${NC}"
    echo ""
}

# Subcommand: clean
cmd_clean() {
    log_info "Selected: System Cleanup"
    ensure_sudo
    log_info "Starting system cleanup..."
    perform_cleanup "false"
}

# Subcommand: deepclean
cmd_deepclean() {
    log_info "Selected: Deep System Cleanup"
    ensure_sudo
    log_info "Starting deep system cleanup..."
    perform_cleanup "true"
}

# Subcommand: spotify
cmd_spotify() {
    log_info "Selected: Spotify Unlocker (SpotX)"
    log_info "Launching SpotX installer..."
    
    # Run SpotX script as requested
    if bash <(curl -sSL https://spotx-official.github.io/run.sh); then
        log_success "SpotX script finished."
    else
        log_error "SpotX script failed to run."
    fi
}

# Subcommand: antigravity
cmd_antigravity() {
    log_info "Selected: Antigravity Installer"
    log_info "This is for Arch users who want to install Antigravity and update it as soon as a release happens (when the AUR packages are not out yet)."
    log_info "Launching Antigravity installer..."
    
    if bash <(curl -sSL https://raw.githubusercontent.com/BOTOOM/google-antigravity-bin-arch/main/install_antigravity); then
        log_success "Antigravity installer finished."
    else
        log_error "Antigravity installer failed to run."
    fi
}

# Subcommand: optmirror
cmd_optmirror() {
    log_info "Selected: Optimize Mirrors"
    if ! command -v reflector &> /dev/null; then
        log_warn "Reflector is not installed. Installing it now..."
        ensure_sudo
        sudo pacman -S --noconfirm reflector
    fi

    ensure_sudo
    log_info "Finding the 10 fastest mirrors in your country..."
    run_with_animation "Updating mirrorlist (this may take a minute)..." "sudo reflector --latest 10 --protocol https --sort rate --save /etc/pacman.d/mirrorlist"
    
    if [[ $? -eq 0 ]]; then
        log_success "Mirrorlist optimized successfully!"
    else
        log_error "Failed to optimize mirrors."
    fi
}

# Subcommand: health
cmd_health() {
    log_info "Selected: System Health Dashboard"
    echo -e "${BLUE}========================================${NC}"
    echo -e "${GREEN}   SYSTEM HEALTH REPORT${NC}"
    echo -e "${BLUE}========================================${NC}"

    # 1. Systemd Failed Units
    local failed_units=$(systemctl --failed --quiet | grep "loaded units listed" | awk '{print $1}')
    if [[ -z "$failed_units" || "$failed_units" == "0" ]]; then
        echo -e "Systemd Services: ${GREEN}[OK]${NC} No failed units."
    else
        echo -e "Systemd Services: ${RED}[ERROR]${NC} $failed_units units failed!"
        systemctl --failed --no-legend --no-pager
    fi

    # 2. Disk Usage (Root)
    local root_usage=$(df -h / | tail -1 | awk '{print $5}' | sed 's/%//')
    if [[ $root_usage -gt 90 ]]; then
        echo -e "Disk Usage (/):   ${RED}[CRITICAL]${NC} ${root_usage}% full!"
    elif [[ $root_usage -gt 75 ]]; then
        echo -e "Disk Usage (/):   ${YELLOW}[WARN]${NC} ${root_usage}% full."
    else
        echo -e "Disk Usage (/):   ${GREEN}[OK]${NC} ${root_usage}% used."
    fi

    # 3. CPU Temperature
    if command -v sensors &> /dev/null; then
        local temp=$(sensors | grep "Package id 0:" | awk '{print $4}' | sed 's/+//;s/°C//')
        if [[ -n "$temp" ]]; then
            if (( $(echo "$temp > 80" | bc -l) )); then
                echo -e "CPU Temp:         ${RED}[HOT]${NC} ${temp}°C"
            else
                echo -e "CPU Temp:         ${GREEN}[OK]${NC} ${temp}°C"
            fi
        fi
    fi

    # 4. Broken Packages
    local broken_list=$(pacman -Qk 2>/dev/null | grep -v "0 missing files")
    local broken_count=$(echo "$broken_list" | grep -v "^$" | wc -l)
    if [[ $broken_count -eq 0 ]]; then
        echo -e "Storage Integrity: ${GREEN}[OK]${NC} No missing files in local database."
    else
        echo -e "Storage Integrity: ${YELLOW}[WARN]${NC} $broken_count packages have missing files!"
        echo -e "${YELLOW}Affected Packages:${NC}"
        echo "$broken_list" | sed 's/:/ ->/' | sed 's/^/  - /'
    fi

    echo -e "${BLUE}========================================${NC}"
}

# Subcommand: systemupdate
cmd_systemupdate() {
    log_info "Selected: Unified System Update"
    ensure_sudo
    
    # 1. Official Repos
    log_info "Updating official repositories..."
    sudo pacman -Syu --noconfirm

    # 2. AUR Helper
    if command -v yay &> /dev/null; then
        log_info "Updating AUR packages (yay)..."
        yay -Sua --noconfirm
    elif command -v paru &> /dev/null; then
        log_info "Updating AUR packages (paru)..."
        paru -Sua --noconfirm
    fi

    # 3. Flatpak
    if command -v flatpak &> /dev/null; then
        log_info "Updating Flatpaks..."
        flatpak update -y
    fi

    log_success "System update complete!"
}
# Subcommand: checkpackageupdates
cmd_checkpackageupdates() {
    log_info "Selected: Safe Update Preview"
    
    if ! command -v checkupdates &> /dev/null; then
        log_warn "checkupdates is required (part of pacman-contrib). Installing..."
        ensure_sudo
        sudo pacman -S --noconfirm pacman-contrib
    fi

    log_info "Checking official repositories for updates..."
    local updates=$(checkupdates)
    if [[ -z "$updates" ]]; then
        log_success "Scale: 0 updates. Your official repos are current!"
    else
        echo -e "${GREEN}Available Official Updates:${NC}"
        echo "$updates" | column -t
        local count=$(echo "$updates" | wc -l)
        echo -e "\nTotal: ${YELLOW}$count${NC} packages"
    fi

    # AUR check
    if command -v yay &> /dev/null; then
        echo ""
        log_info "Checking AUR for updates (yay)..."
        local aur_updates=$(yay -Qua)
        if [[ -z "$aur_updates" ]]; then
            log_success "AUR is current!"
        else
            echo -e "${GREEN}Available AUR Updates:${NC}"
            echo "$aur_updates" | column -t
        fi
    fi
}

# Subcommand: battery
cmd_battery() {
    log_info "Selected: Battery Health Dashboard"
    
    local bat_path=""
    for b in /sys/class/power_supply/BAT*; do
        if [[ -d "$b" ]]; then
            bat_path="$b"
            break
        fi
    done

    if [[ -z "$bat_path" ]]; then
        log_error "No battery detected on this system."
        return
    fi

    echo -e "${BLUE}========================================${NC}"
    echo -e "${GREEN}   BATTERY STATUS REPORT${NC}"
    echo -e "${BLUE}========================================${NC}"

    local status=$(cat "$bat_path/status")
    local capacity=$(cat "$bat_path/capacity")
    local model=$(cat "$bat_path/model_name")
    
    # Energy in uWh
    local energy_full=$(cat "$bat_path/energy_full")
    local energy_design=$(cat "$bat_path/energy_full_design")
    local power_now=$(cat "$bat_path/power_now") # in uW
    local voltage_now=$(cat "$bat_path/voltage_now") # in uV
    
    # Calculate health
    local health=$(echo "scale=2; ($energy_full / $energy_design) * 100" | bc -l)
    
    # Calculate Watts
    local watts=$(echo "scale=2; $power_now / 1000000" | bc -l)

    echo -e "Device:           ${BLUE}$model${NC}"
    echo -e "Status:           ${YELLOW}$status${NC}"
    
    if [[ $capacity -gt 20 ]]; then
        echo -e "Charge:           ${GREEN}$capacity%${NC}"
    else
        echo -e "Charge:           ${RED}$capacity% [LOW]${NC}"
    fi

    echo -e "Health:           ${GREEN}$health%${NC} of original capacity"
    echo -e "Current Draw:     ${BLUE}$watts W${NC}"
    
    if [[ -f "$bat_path/cycle_count" ]]; then
        local cycles=$(cat "$bat_path/cycle_count")
        echo -e "Cycle Count:      ${BLUE}$cycles${NC}"
    fi

    echo -e "${BLUE}========================================${NC}"
}

# Subcommand: profiles
cmd_profiles() {
    log_info "Detecting available power profiles..."
    local profiles=$(get_available_profiles)
    if [[ -z "$profiles" ]]; then
        log_warn "No ACPI platform profiles detected."
    else
        echo -e "${GREEN}Available Profiles:${NC}"
        for p in $profiles; do
            echo "  - $p"
        done
        echo ""
        echo "You can run these as commands: sanuu <profile_name>"
    fi
}

# Subcommand: help
cmd_help() {
    echo -e "${GREEN}Sanuu Command Tool${NC}"
    echo "Usage: sanuu [command]"
    echo ""
    echo "Commands:"
    echo "  clean         Clean system cache, orphans, and logs"
    echo "  deepclean     Same as clean + temp files, trash, thumbnails"
    echo "  optmirror     Optimize mirrorlist using Reflector"
    echo "  health        Show system health dashboard"
    echo "  systemupdate  Update Repos, AUR, and Flatpaks"
    echo "  checkpackageupdates  Safe preview of available updates"
    echo "  battery       Show detailed battery health (Laptops)"
    echo "  spotify       Run SpotX Spotify unlocker"
    echo "  antigravity   Install/Update Antigravity (latest release)"
    echo "  profiles      List detected power profiles"
    
    local profiles=$(get_available_profiles)
    if [[ -n "$profiles" ]]; then
        echo ""
        echo "Detected Power Profiles (Dynamic):"
        for p in $profiles; do
            echo "  $p"
        done
    fi
    
    echo "  help          Show this help message"
}

# Run auto-update check before any command if not running help
if [[ "$1" != "help" && "$1" != "--help" && "$1" != "-h" ]]; then
    check_for_updates
fi

# Main logic
case "$1" in
    clean)
        cmd_clean
        ;;
    deepclean)
        cmd_deepclean
        ;;
    optmirror)
        cmd_optmirror
        ;;
    health)
        cmd_health
        ;;
    systemupdate)
        cmd_systemupdate
        ;;
    checkpackageupdates)
        cmd_checkpackageupdates
        ;;
    battery)
        cmd_battery
        ;;
    spotify)
        cmd_spotify
        ;;
    antigravity)
        cmd_antigravity
        ;;
    profiles)
        cmd_profiles
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        # Dynamic Profile Check
        if [[ -n "$1" ]]; then
            # Check if ACPI profiles exist
             if [[ -f "$ACPI_CHOICES" ]]; then
                 if grep -q "$1" "$ACPI_CHOICES"; then
                     set_profile "$1"
                     exit 0
                 fi
             fi
        fi
        
        log_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
