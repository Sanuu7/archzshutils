#!/bin/bash

# Sanuu Command Tool
# A utility script for Arch Linux users.

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# ACPI Platform Profile Path
ACPI_PROFILE="/sys/firmware/acpi/platform_profile"
ACPI_CHOICES="/sys/firmware/acpi/platform_profile_choices"

# GitHub Repo Info
REPO_USER="Sanuu7"
REPO_NAME="archzshutils"
SCRIPT_FILE="sanuu"
INSTALLED_HASH="Unknown" # This will be replaced by install.sh

# Helper function for logging
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Render a compact progress bar. First argument is percent, second is bar width.
draw_bar() {
    local percent="$1"
    local width="${2:-28}"
    local filled=$(( percent * width / 100 ))
    local empty=$(( width - filled ))
    local bar=""

    for ((i = 0; i < filled; i++)); do bar+="█"; done
    for ((i = 0; i < empty; i++)); do bar+="░"; done

    if [[ $percent -ge 90 ]]; then
        echo -e "${RED}${bar}${NC}"
    elif [[ $percent -ge 75 ]]; then
        echo -e "${YELLOW}${bar}${NC}"
    else
        echo -e "${GREEN}${bar}${NC}"
    fi
}

# Convert KiB values to a readable IEC unit.
format_kib() {
    local kib="${1:-0}"

    awk -v kib="$kib" 'BEGIN {
        split("KiB MiB GiB TiB PiB", units, " ")
        value = kib
        unit = 1
        while (value >= 1024 && unit < 5) {
            value /= 1024
            unit++
        }
        if (value >= 100 || unit == 1) {
            printf "%.0f %s", value, units[unit]
        } else {
            printf "%.1f %s", value, units[unit]
        }
    }'
}

spec_intro_animation() {
    if [[ ! -t 1 ]]; then
        return
    fi

    local frames=("◐" "◓" "◑" "◒")
    tput civis 2>/dev/null || true
    for i in {1..16}; do
        printf "\r${CYAN}%s${NC} ${BOLD}scanning silicon, memory, and storage...${NC}" "${frames[$((i % 4))]}"
        sleep 0.045
    done
    printf "\r%*s\r" 60 ""
    tput cnorm 2>/dev/null || true
}

spec_card() {
    local icon="$1"
    local title="$2"
    local subtitle="$3"
    local used="$4"
    local total="$5"
    local percent="$6"
    local accent="$7"
    local bar
    bar=$(draw_bar "$percent" 26)

    echo -e "${accent}╭────────────────────────────────────────────╮${NC}"
    printf "%b│%b %b%-40s%b%b│%b\n" "$accent" "$NC" "$accent" "$icon  $title" "$NC" "$accent" "$NC"
    printf "%b│%b %-42s %b│%b\n" "$accent" "$DIM" "$subtitle" "$accent" "$NC"
    printf "%b│%b %-12s %b%-12s%b %3s%% %b│%b\n" "$accent" "$NC" "$used used" "$DIM" "$total total" "$NC" "$percent" "$accent" "$NC"
    printf "%b│%b %b                 %b│%b\n" "$accent" "$NC" "$bar" "$accent" "$NC"
    echo -e "${accent}╰────────────────────────────────────────────╯${NC}"
}

read_memory_specs() {
    local total_kib available_kib used_kib percent
    total_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    available_kib=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    used_kib=$(( total_kib - available_kib ))
    percent=$(( used_kib * 100 / total_kib ))

    SPEC_RAM_USED=$(format_kib "$used_kib")
    SPEC_RAM_TOTAL=$(format_kib "$total_kib")
    SPEC_RAM_AVAILABLE=$(format_kib "$available_kib")
    SPEC_RAM_PERCENT="$percent"
}

read_storage_specs() {
    local home_dir df_summary filesystem_count total_kib used_kib available_kib percent
    if [[ -n "$SUDO_USER" ]]; then
        home_dir="/home/$SUDO_USER"
    else
        home_dir="$HOME"
    fi

    df_summary=$(df -k -P / "$home_dir" 2>/dev/null | tail -n +2 | sort -u -k1,1 | awk '
        { total += $2; used += $3; available += $4; count++ }
        END { printf "%d %d %d %d", total, used, available, count }
    ')
    read -r total_kib used_kib available_kib filesystem_count <<< "$df_summary"
    percent=$(( used_kib * 100 / total_kib ))

    SPEC_STORAGE_USED=$(format_kib "$used_kib")
    SPEC_STORAGE_TOTAL=$(format_kib "$total_kib")
    SPEC_STORAGE_AVAILABLE=$(format_kib "$available_kib")
    SPEC_STORAGE_PERCENT="$percent"
    if [[ "$filesystem_count" -gt 1 ]]; then
        SPEC_STORAGE_MOUNT="/ + home"
    else
        SPEC_STORAGE_MOUNT="/ and home"
    fi
}

read_vram_specs() {
    local total_mib used_mib gpu_name total_kib used_kib percent

    if command -v nvidia-smi &> /dev/null; then
        local smi_line
        smi_line=$(nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv,noheader,nounits 2>/dev/null | head -n 1)
        if [[ -n "$smi_line" ]]; then
            IFS=',' read -r gpu_name total_mib used_mib <<< "$smi_line"
            gpu_name=$(echo "$gpu_name" | xargs)
            total_mib=$(echo "$total_mib" | xargs)
            used_mib=$(echo "$used_mib" | xargs)
            total_kib=$(( total_mib * 1024 ))
            used_kib=$(( used_mib * 1024 ))
        fi
    fi

    if [[ -z "$total_kib" ]]; then
        for device in /sys/class/drm/card*/device; do
            if [[ -r "$device/mem_info_vram_total" ]]; then
                total_kib=$(( $(cat "$device/mem_info_vram_total") / 1024 ))
                if [[ -r "$device/mem_info_vram_used" ]]; then
                    used_kib=$(( $(cat "$device/mem_info_vram_used") / 1024 ))
                else
                    used_kib=0
                fi
                if command -v lspci &> /dev/null; then
                    local pci_id
                    pci_id=$(basename "$(readlink -f "$device")")
                    gpu_name=$(lspci -s "$pci_id" 2>/dev/null | sed 's/.*: //')
                fi
                break
            fi
        done
    fi

    if [[ -n "$total_kib" && "$total_kib" -gt 0 ]]; then
        percent=$(( used_kib * 100 / total_kib ))
        SPEC_VRAM_USED=$(format_kib "$used_kib")
        SPEC_VRAM_TOTAL=$(format_kib "$total_kib")
        SPEC_VRAM_AVAILABLE=$(format_kib "$(( total_kib - used_kib ))")
        SPEC_VRAM_PERCENT="$percent"
        SPEC_GPU_NAME="${gpu_name:-Dedicated GPU}"
        return
    fi

    if command -v lspci &> /dev/null; then
        gpu_name=$(lspci | grep -Ei 'vga|3d|display' | head -n 1 | sed 's/.*: //')
    fi

    SPEC_VRAM_USED="shared"
    SPEC_VRAM_TOTAL="system RAM"
    SPEC_VRAM_AVAILABLE="dynamic"
    SPEC_VRAM_PERCENT=0
    SPEC_GPU_NAME="${gpu_name:-Integrated/shared graphics}"
}

# Animation function
run_with_animation() {
    local message="$1"
    shift
    local command="$@"
    
    local start_kb=$(get_free_space_kb)
    local log_file="/tmp/sanuu_step.log"
    
    echo -ne "${BLUE}[WAIT]${NC} $message"
    
    # Hide cursor
    tput civis
    
    # Run command and capture output
    eval "$command" > /dev/null 2> "$log_file" &
    local pid=$!
    
    local spinstr='|/-\'
    while kill -0 $pid 2>/dev/null; do
        local temp=${spinstr#?}
        printf " ${BLUE}[%c]${NC}" "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep 0.1
        printf "\b\b\b\b"
    done
    wait $pid
    local exit_code=$?
    
    # Show cursor
    tput cnorm
    
    local end_kb=$(get_free_space_kb)
    local diff_kb=$(( end_kb - start_kb ))
    if [[ $diff_kb -lt 0 ]]; then diff_kb=0; fi
    
    # Convert to MB or KB depending on size
    local reclaimed_text
    if [[ $diff_kb -ge 1024 ]]; then
        local diff_mb=$(awk "BEGIN {printf \"%.2f\", $diff_kb / 1024}")
        reclaimed_text="${YELLOW}${diff_mb} MB${NC}"
    else
        reclaimed_text="${YELLOW}${diff_kb} KB${NC}"
    fi

    if [ $exit_code -eq 0 ]; then
        echo -e " ${GREEN}[DONE]${NC} ($reclaimed_text)"
    else
        echo -e " ${RED}[FAIL]${NC}"
        if [[ -f "$log_file" && -s "$log_file" ]]; then
            echo -e "       ${RED}└─ Reason:${NC} $(tail -n 1 "$log_file" | sed 's/^error: //')"
        fi
    fi
    rm -f "$log_file"
    return $exit_code
}

# Helper to request sudo if not root
ensure_sudo() {
    if [[ $EUID -ne 0 ]]; then
        sudo -v
        if [[ $? -ne 0 ]]; then
            log_error "Sudo privileges are required for this operation."
            exit 1
        fi
    fi
}

# Auto-update Check
check_for_updates() {
    # Skip if offline or API unreachable
    if ! ping -c 1 github.com &> /dev/null; then
        return
    fi
    
    echo -ne "${BLUE}[INFO]${NC} Checking for updates..."
    
    # Fetch latest commit from GitHub API
    local api_url="https://api.github.com/repos/$REPO_USER/$REPO_NAME/commits?path=$SCRIPT_FILE&per_page=1"
    local response=$(curl -s -m 5 "$api_url")
    
    if [[ -z "$response" ]]; then
        echo -e "\r${YELLOW}[WARN] Failed to check for updates.${NC}          "
        return
    fi
    
    # Extract latest hash and message (simple parsing to avoid jq dependency)
    local latest_hash=$(echo "$response" | grep '"sha":' | head -n 1 | cut -d '"' -f 4)
    local message=$(echo "$response" | grep '"message":' | head -n 1 | cut -d '"' -f 4)
    
    echo -e "\r                                             \r" # Clear line
    
    if [[ -n "$latest_hash" && "$latest_hash" != "$INSTALLED_HASH" && "$INSTALLED_HASH" != "Unknown" ]]; then
        echo -e "${GREEN}Update Available!${NC}"
        echo -e "Summary: ${YELLOW}New version found on GitHub${NC}"
        echo -e "Changelog: ${BLUE}$message${NC}"
        echo ""
        read -p "Do you want to update now? (y/n): " choice
        if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
            log_info "Updating..."
            ensure_sudo
            
            local download_url="https://raw.githubusercontent.com/$REPO_USER/$REPO_NAME/main/$SCRIPT_FILE"
            local temp_file="/tmp/$SCRIPT_FILE.new"
            
            if curl -s -L "$download_url" -o "$temp_file"; then
                # Inject new hash into the downloaded script before installing
                sed -i "s/INSTALLED_HASH=\"Unknown\"/INSTALLED_HASH=\"$latest_hash\"/" "$temp_file"
                
                chmod +x "$temp_file"
                sudo mv "$temp_file" "$(command -v sanuu)"
                log_success "Update successful! Please run your command again."
                exit 0
            else
                log_error "Failed to download update."
            fi
        fi
    fi
}

# Helper to get available profiles
get_available_profiles() {
    if [[ -f "$ACPI_CHOICES" ]]; then
        cat "$ACPI_CHOICES"
    else
        echo ""
    fi
}

# Helper to set ACPI profile
set_profile() {
    local target_profile="$1"
    
    # Check if profile exists
    local available_profiles=$(get_available_profiles)
    if [[ " $available_profiles " =~ " $target_profile " ]]; then
        log_info "Selected: $target_profile mode"
        ensure_sudo
        log_info "Applying settings..."
        
        # Set ACPI Profile
        echo "$target_profile" | sudo tee "$ACPI_PROFILE" > /dev/null
        log_success "ACPI profile set to $target_profile."
        
        # CPU Governor Logic (Best Effort mapping)
        if command -v cpupower &> /dev/null; then
            local governor="powersave"
            case "$target_profile" in
                performance)
                    governor="performance"
                    ;;
                balanced|balance)
                    if grep -q "schedutil" /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors; then
                        governor="schedutil"
                    else
                        governor="powersave"
                    fi
                    ;;
                low-power|quiet|silent)
                    governor="powersave"
                    ;;
            esac
            sudo cpupower frequency-set -g "$governor" > /dev/null
            log_success "CPU governor set to $governor."
        fi
        
    else
        log_error "Profile '$target_profile' is not available on this system."
        log_info "Available profiles: $available_profiles"
        exit 1
    fi
}

# Helper to get total available space in KB
# Sums available space of / and /home (deduplicating if they are the same)
get_free_space_kb() {
    # Check partitions for root and home user's cache
    local home_dir
    if [[ -n "$SUDO_USER" ]]; then
        home_dir="/home/$SUDO_USER"
    else
        home_dir="$HOME"
    fi
    
    df -k / "$home_dir" 2>/dev/null | tail -n +2 | awk '{print $1, $4}' | sort -u -k1,1 | awk '{sum+=$2} END {print sum}'
}

# clean logic extracted for reuse
perform_cleanup() {
    local deep=$1
    
    # Measure start space
    local start_space=$(get_free_space_kb)

    # Ensure no pacman lock
    if [[ -f /var/lib/pacman/db.lck ]]; then
        log_warn "Pacman database is locked. Waiting..."
        while [[ -f /var/lib/pacman/db.lck ]]; do
            sleep 1
        done
        log_success "Lock released."
    fi
    
    # 1. Clean pacman cache
    run_with_animation "Cleaning pacman cache (keep latest 2)..." "sudo paccache -rk2"
    run_with_animation "Cleaning uninstalled packages cache..." "sudo paccache -ruk0"

    # 2. Clean AUR helper cache (yay/paru)
    if [[ $EUID -eq 0 && -n "$SUDO_USER" ]]; then
         if command -v yay &> /dev/null; then
             run_with_animation "Cleaning yay cache..." "sudo -u $SUDO_USER yay -Sc --noconfirm"
         elif command -v paru &> /dev/null; then
             run_with_animation "Cleaning paru cache..." "sudo -u $SUDO_USER paru -Sc --noconfirm"
         fi
    else
         if command -v yay &> /dev/null; then
             run_with_animation "Cleaning yay cache..." "yay -Sc --noconfirm"
         elif command -v paru &> /dev/null; then
             run_with_animation "Cleaning paru cache..." "paru -Sc --noconfirm"
         fi
    fi

    # 3. Remove orphaned packages
    local orphans=$(pacman -Qtdq | tr '\n' ' ')
    if [[ -n "$orphans" ]]; then
        run_with_animation "Removing orphaned packages..." "sudo pacman -Rns $orphans --noconfirm"
    else
        run_with_animation "Checking for orphaned packages..." "sleep 0.5"
    fi

    # 4. Vacuum journal logs
    run_with_animation "Vacuuming system journal..." "sudo journalctl --vacuum-time=2weeks"

    # 5. Deep Clean specific
    if [[ "$deep" == "true" ]]; then
        log_info "Starting Deep Clean operations..."
        
        # User cache (thumbnails)
        if [[ -n "$SUDO_USER" ]]; then
             run_with_animation "Clearing user thumbnails..." "sudo -u $SUDO_USER rm -rf /home/$SUDO_USER/.cache/thumbnails/*"
        else
             run_with_animation "Clearing user thumbnails..." "rm -rf $HOME/.cache/thumbnails/*"
        fi
        
        # Temp files
        run_with_animation "Clearing /tmp directory (safe removal)..." "sudo find /tmp -type f -atime +1 -delete"
        run_with_animation "Clearing /var/tmp directory (safe removal)..." "sudo find /var/tmp -type f -atime +1 -delete"
        
        # Trash
        if [[ -n "$SUDO_USER" ]]; then
             run_with_animation "Emptying user trash..." "sudo -u $SUDO_USER rm -rf /home/$SUDO_USER/.local/share/Trash/*"
        else
             run_with_animation "Emptying trash..." "rm -rf $HOME/.local/share/Trash/*"
        fi

        # Terminal and REPL histories
        if [[ -n "$SUDO_USER" ]]; then
             local home_path="/home/$SUDO_USER"
             run_with_animation "Clearing shell and REPL histories..." "sudo -u $SUDO_USER rm -f $home_path/.zsh_history $home_path/.bash_history $home_path/.python_history $home_path/.node_repl_history $home_path/.zsh_history_bad"
             run_with_animation "Clearing shell completion caches..." "sudo -u $SUDO_USER rm -f $home_path/.zcompdump*"
        else
             run_with_animation "Clearing shell and REPL histories..." "rm -f $HOME/.zsh_history $HOME/.bash_history $HOME/.python_history $HOME/.node_repl_history $HOME/.zsh_history_bad"
             run_with_animation "Clearing shell completion caches..." "rm -f $HOME/.zcompdump*"
        fi
    fi
    
    # Measure end space
    local end_space=$(get_free_space_kb)
    
    # Calculate difference
    local diff_kb=$(( end_space - start_space ))
    
    # Handle case where diff is negative (downloads etc during run) or zero
    if [[ $diff_kb -lt 0 ]]; then diff_kb=0; fi
    
    local diff_mb=$(awk "BEGIN {printf \"%.2f\", $diff_kb / 1024}")
    
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}   CLEANUP COMPLETE${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo -e "Reclaimed Space: ${YELLOW}${diff_mb} MB${NC}"
    echo ""
}

